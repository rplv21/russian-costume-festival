---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DollScroller from '../components/DollScroller.astro';
import { festival, yandexMetricaId } from '../data/site';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  hideDoll?: boolean;
}

const { title, description, noindex = false, hideDoll = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const eventSchema = {
  '@context': 'https://schema.org',
  '@type': 'Festival',
  name: festival.fullName,
  startDate: festival.dates.start,
  endDate: festival.dates.end,
  location: {
    '@type': 'Place',
    address: {
      '@type': 'PostalAddress',
      addressLocality: festival.city,
      addressCountry: 'RU',
    },
  },
};
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="ru_RU" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(eventSchema)} />

    {!noindex && yandexMetricaId && (
      <>
        {/* Яндекс.Метрика — считает переходы с рекламы (ВК Таргет, Яндекс.Директ)
            по UTM-меткам в ссылках; не показывается на служебных страницах (noindex). */}
        <script is:inline define:vars={{ id: yandexMetricaId }}>
          (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
          m[i].l=1*new Date();
          for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
          k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})
          (window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js', 'ym');

          ym(id, 'init', {
            clickmap: true,
            trackLinks: true,
            accurateTrackBounce: true,
            webvisor: true,
          });
        </script>
        <noscript>
          <div>
            <img src={`https://mc.yandex.ru/watch/${yandexMetricaId}`} style="position:absolute; left:-9999px;" alt="" />
          </div>
        </noscript>
      </>
    )}
  </head>
  <body>
    <a href="#main" class="sr-only">Перейти к содержимому</a>
    {!hideDoll && <DollScroller />}
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
