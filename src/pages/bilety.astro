---
import Layout from '../layouts/Layout.astro';
import SeatMap from '../components/SeatMap.astro';
import { contacts } from '../data/site';
---

<Layout
  title="Билеты — Русский костюм"
  description="Бесплатное бронирование билетов на 16 и 17 октября 2026 года и информация о билетах на гала-концерт фестиваля «Русский костюм в городе Ярославле»."
>
  <section class="section container">
    <p class="eyebrow">Билеты</p>
    <h1>Бронирование на бесплатные дни</h1>
    <p class="lede">
      16 и 17 октября вход на фестиваль свободный по предварительной регистрации. Выберите день и
      места на схеме зала — билет в формате PDF придёт на почту и будет доступен для скачивания
      сразу после бронирования.
    </p>

    <SeatMap />
  </section>

  <section class="section container gala" id="gala">
    <p class="eyebrow">Гала-концерт · 18 октября</p>
    <h2>Билеты на гала-концерт</h2>
    <p class="lede">
      18 октября — платный день фестиваля. Билеты продаёт официальный билетный оператор,
      бронирование и оплата — прямо на этой странице.
    </p>

    <div id="ya-widget-frame"></div>

    <p class="note">
      Если виджет не загрузился — билеты также можно купить на{' '}
      <a href="https://yar-show.ru/events/shou/russkiy-kostyum/" target="_blank" rel="noopener">
        странице билетного оператора
      </a>.
    </p>
    <div class="contacts">
      <a href={contacts.orgPhoneHref} class="btn btn-outline">{contacts.orgPhone}</a>
      <a href={contacts.vk.festival} target="_blank" rel="noopener" class="btn btn-outline">
        Новости в VK
      </a>
    </div>
  </section>
</Layout>

<script is:inline>
  /* Виджет билетного оператора (Яндекс Афиша) — вставлен как есть, по
     инструкции менеджера оператора. Не трогать без согласования с ним:
     dealerName/clientKey/widget id привязаны к конкретному событию. */
  var dealerName = 'YandexTicketsDealer';
  var dealer = window[dealerName] = window[dealerName] || [];

  dealer.push(['setDefaultClientKey', '220bf208-120e-4ee2-b089-7cc1e7a7462f']);
  dealer.push(['setDefaultRegionId', 16]);

  YandexTicketsDealer.push(['getDealer', function (dealer) {
    const widget = dealer.Widget('ticketsteam-681@63426795', 'session', {
      target: document.getElementById('ya-widget-frame'),
      onRequestClose: function() {
        widget.unmount();
        widget.destroy();
      },
    });

    widget.mount({ style: { height: '600px' } });
  }]);

  (function () {
    var rnd = '?' + new Date().getTime() * Math.random();
    var script = document.createElement('script');
    var target = document.getElementsByTagName('script')[0];
    script.async = true;
    script.src = 'https://widget.afisha.yandex.ru/dealer/dealer.js' + rnd;
    target.parentNode.insertBefore(script, target);
  })();
</script>

<style>
  .lede {
    max-width: 68ch;
    color: var(--color-text-muted);
    font-size: 1.05rem;
    margin-top: 14px;
  }
  .gala {
    text-align: center;
    padding-block: clamp(56px, 8vw, 96px);
    border-top: 1px solid var(--color-border);
  }
  .gala .lede {
    margin: 18px auto 28px;
  }
  #ya-widget-frame {
    max-width: 640px;
    margin-inline: auto;
    text-align: left;
  }
  .contacts {
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 24px;
  }
  .note {
    margin-top: 24px;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }
  .note a {
    color: var(--color-red);
  }
</style>
