---
// Читаем список файлов из public/gallery — доступно только на этапе сборки
// (в проде public/ не попадает в финальный образ), поэтому страница должна
// быть статической (см. тот же приём в src/pages/proshedshie/2024.astro).
export const prerender = true;

import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';
import { festival, programme, contacts, pastFestivals } from '../data/site';

const lastFestival = pastFestivals[0];
const lastGalleryDir = lastFestival ? path.resolve(`public/gallery/${lastFestival.slug}/thumb`) : null;
const lastGalleryFiles =
  lastGalleryDir && fs.existsSync(lastGalleryDir)
    ? fs.readdirSync(lastGalleryDir).filter((f) => f.toLowerCase().endsWith('.jpg')).sort()
    : [];

// Перемешиваем один раз на этапе сборки: витрина показывает не первые файлы
// по алфавиту, а вразброс. PREVIEW_COUNT фото видно сразу, остальные —
// пул, из которого плитки на клиенте по очереди подтягивают следующий кадр.
function shuffle<T>(arr: T[]): T[] {
  const out = [...arr];
  for (let i = out.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [out[i], out[j]] = [out[j], out[i]];
  }
  return out;
}

const PREVIEW_COUNT = 8;
const shuffledPhotoPool = lastFestival
  ? shuffle(lastGalleryFiles.map((name) => `/gallery/${lastFestival!.slug}/thumb/${name}`))
  : [];
const previewPhotos = shuffledPhotoPool.slice(0, PREVIEW_COUNT);
---

<Layout
  title="Русский костюм — Всероссийский фестиваль в Ярославле, 16–18 октября 2026"
  description="Всероссийский фестиваль-конкурс «Русский костюм в городе Ярославле»: показы коллекций, выставки, ярмарка и гала-концерт. 16–18 октября 2026 года."
>
  <section class="hero container">
    <p class="eyebrow">Всероссийский фестиваль · {festival.city}</p>
    <h1>Русский костюм</h1>
    <p class="hero-dates">{festival.dates.label}</p>
    <p class="hero-lede">{festival.intro}</p>
    <div class="hero-cta">
      <a href="/bilety" class="btn btn-red">Билеты на гала-концерт</a>
    </div>
  </section>

  <section class="section container days">
    {festival.days.map((day) => (
      <div class="day-card">
        <span class="day-date">{day.date}</span>
        <span class="day-title">{day.title}</span>
        <a href={day.ticketsHref} class="btn btn-red day-btn">Билеты</a>
      </div>
    ))}
  </section>

  {previewPhotos.length > 0 && lastFestival && (
    <section class="section container past-festival">
      <div class="section-head">
        <h2>Как это было в {lastFestival.year} году</h2>
      </div>
      <div class="past-photo-grid" id="past-photo-grid">
        {previewPhotos.map((src, i) => (
          <div class="past-photo" data-index={i}>
            <img src={src} alt={`Русский костюм ${lastFestival.year} — фото ${i + 1}`} loading="lazy" />
          </div>
        ))}
      </div>
      <a href={`/proshedshie/${lastFestival.slug}`} class="btn btn-outline past-photo-link">
        Смотреть все фото фестиваля {lastFestival.year}
      </a>
      <script type="application/json" id="past-photo-pool" is:inline set:html={JSON.stringify(shuffledPhotoPool)} />
    </section>
  )}

  <section class="section container">
    <div class="section-head">
      <h2>Традиции и современность</h2>
    </div>
    <p class="lede">
      В фестивале участвуют лучшие художники-модельеры, коллективы творческих мастерских и
      фольклорные ансамбли более чем из {festival.regionsCount} регионов России — от хранителей
      этнографической реконструкции до современных авторских дизайнеров, работающих с
      традиционными мотивами языком сегодняшней моды.
    </p>
  </section>

  <section class="section container programme">
    <div class="prog-col">
      <h3>Конкурсная часть</h3>
      <ul>
        {programme.competitive.map((item) => (
          <li>{item.title}{item.desc && <span class="muted"> — {item.desc}</span>}</li>
        ))}
      </ul>
    </div>
    <div class="prog-col">
      <h3>Деловая программа</h3>
      <ul>
        {programme.business.map((item) => <li>{item}</li>)}
      </ul>
    </div>
    <div class="prog-col">
      <h3>Для гостей</h3>
      <ul>
        {programme.guests.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="section container nav-cards">
    <a href="/o-festivale" class="nav-card">
      <span>О фестивале</span>
      <p>Учредители, цели, номинации 2026 года</p>
    </a>
    <a href="/dokumenty" class="nav-card">
      <span>Документы</span>
      <p>Положение о фестивале и формы заявок</p>
    </a>
    <a href="/vystavka" class="nav-card">
      <span>Выставка</span>
      <p>Кукла в традиционном костюме, костюмы, аксессуары</p>
    </a>
    <a href="/galereya" class="nav-card">
      <span>Галерея</span>
      <p>Фото фестиваля</p>
    </a>
  </section>

  <section class="section container">
    <div class="contact-strip">
      <p class="eyebrow">По вопросам участия</p>
      <p class="contact-line"><a href={contacts.orgPhoneHref}>{contacts.orgPhone}</a></p>
      <p class="contact-line"><a href={`mailto:${contacts.confirmationEmail}`}>{contacts.confirmationEmail}</a></p>
    </div>
  </section>
</Layout>

<script>
  // Витрина фото прошлого фестиваля раз в 7 секунд листает все плитки разом —
  // веерной волной слева направо (как "волна" на стадионе): каждая следующая
  // плитка размывается чуть позже предыдущей, под размытием подменяется
  // фото, затем резкость возвращается — в той же последовательности.
  const grid = document.getElementById('past-photo-grid');
  const poolEl = document.getElementById('past-photo-pool');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (grid && poolEl && !prefersReducedMotion) {
    const pool = JSON.parse(poolEl.textContent || '[]') as string[];
    const tiles = Array.from(grid.querySelectorAll<HTMLElement>('.past-photo'));
    const nextIndexByTile = tiles.map((_, i) => i + tiles.length);

    const CYCLE_MS = 7000;
    const WAVE_STEP_MS = 110; // задержка волны между соседними плитками

    function runWave() {
      if (pool.length <= tiles.length) return;
      tiles.forEach((tile, i) => {
        const img = tile.querySelector('img');
        if (!img) return;
        const delay = i * WAVE_STEP_MS;

        setTimeout(() => {
          tile.classList.add('is-changing');
        }, delay);
        setTimeout(() => {
          img.src = pool[nextIndexByTile[i] % pool.length];
          nextIndexByTile[i] += tiles.length;
        }, delay + 320);
        setTimeout(() => {
          tile.classList.remove('is-changing');
        }, delay + 420);
      });
    }

    setInterval(runWave, CYCLE_MS);
    setTimeout(runWave, 2500);
  }
</script>

<style>
  .hero {
    padding-block: clamp(64px, 10vw, 120px) clamp(40px, 6vw, 64px);
  }
  .hero h1 {
    font-size: clamp(3.2rem, 9vw, 6.5rem);
    margin-block: 12px 4px;
  }
  .hero-dates {
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--color-red);
    margin-bottom: 20px;
  }
  .hero-lede {
    max-width: 62ch;
    font-size: 1.1rem;
    color: var(--color-text-muted);
  }
  .hero-cta {
    display: flex;
    gap: 14px;
    margin-top: 32px;
    flex-wrap: wrap;
  }

  .days {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    padding-block: 0 clamp(40px, 6vw, 64px);
  }
  .day-card {
    background: var(--color-surface);
    border-radius: var(--radius-card);
    padding: 24px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
  }
  .day-date {
    font-weight: 700;
    color: var(--color-blue);
  }
  .day-title {
    font-size: 1.3rem;
    font-family: var(--font-display);
    color: var(--color-ink);
    margin-bottom: 10px;
  }
  .day-btn {
    padding: 10px 20px;
    font-size: 0.85rem;
  }

  .past-photo-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-bottom: 24px;
  }
  .past-photo {
    position: relative;
    border-radius: var(--radius-card);
    overflow: hidden;
    aspect-ratio: 1;
    background: var(--color-surface);
  }
  .past-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: blur(0);
    transition: filter 0.4s ease;
  }
  .past-photo.is-changing img {
    filter: blur(14px);
    transition-duration: 0.32s;
  }
  .past-photo-link {
    display: inline-block;
  }

  .section-head h2 {
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    margin-bottom: 18px;
  }
  .lede {
    max-width: 76ch;
    color: var(--color-text-muted);
    font-size: 1.05rem;
  }

  .programme {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .prog-col h3 {
    font-size: 1.3rem;
    margin-bottom: 14px;
    color: var(--color-red);
  }
  .prog-col ul {
    margin: 0;
    padding-left: 18px;
    color: var(--color-text);
  }
  .prog-col li {
    margin-bottom: 8px;
  }
  .muted {
    color: var(--color-text-muted);
  }

  .nav-cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  .nav-card {
    display: block;
    background: var(--color-surface);
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius-card);
    padding: 24px;
    text-decoration: none;
    color: var(--color-ink);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .nav-card:hover {
    border-color: var(--color-red);
    transform: translateY(-2px);
  }
  .nav-card span {
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--color-blue);
  }
  .nav-card p {
    margin-top: 8px;
    font-size: 0.9rem;
    color: var(--color-ink-muted);
  }

  .contact-strip {
    background: var(--color-surface);
    border-radius: var(--radius-card);
    padding: 32px;
  }
  .contact-line {
    font-size: 1.1rem;
    font-weight: 600;
    margin-top: 6px;
  }
  .contact-line a {
    text-decoration: none;
    color: var(--color-blue);
  }

  @media (max-width: 900px) {
    .days,
    .programme,
    .nav-cards {
      grid-template-columns: 1fr 1fr;
    }
    .past-photo-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 600px) {
    .days,
    .programme,
    .nav-cards {
      grid-template-columns: 1fr;
    }
    .past-photo-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
